<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>
  <group name="General">
    <entry name="servers" type="String">
      <label>Servers</label>
      <default>[]</default>
    </entry>
  </group>
  <group name="Appearance">
    <entry name="fontSize" type="int">
      <label>Font size</label>
      <default>12</default>
    </entry>
	<entry name="iconOnline" type="String">
      <label>Online icon</label>
      <default>security-high</default>
    </entry>
	<entry name="iconOffline" type="String">
      <label>Offline icon</label>
      <default>security-low</default>
    </entry>
    <entry name="latencyHistoryMinutes" type="Int">
      <label>Minutes of latency history to keep</label>
      <default>60</default>
    </entry>
  </group>
  <group name="Notifications">
    <entry name="notificationUpAction" type="Int">
      <label>Action when a server goes online</label>
      <default>0</default>
    </entry>
    <entry name="notificationUpCommand" type="String">
      <label>Command when a server goes online</label>
      <default></default>
    </entry>
    <entry name="notificationDownAction" type="Int">
      <label>Action when a server goes offline</label>
      <default>1</default>
    </entry>
    <entry name="notificationDownCommand" type="String">
      <label>Command when a server goes offline</label>
      <default></default>
    </entry>
    <entry name="notificationConfigMigrated" type="Bool">
      <label>Whether the legacy notification configuration has been migrated</label>
      <default>false</default>
    </entry>
    <entry name="diagnosticAutoOffline" type="Bool">
      <label>Run a network diagnostic when a server goes offline</label>
      <default>true</default>
    </entry>
    <entry name="diagnosticCycles" type="Int">
      <label>Number of ping cycles for network diagnostics</label>
      <default>3</default>
    </entry>
    <entry name="notificationUp" type="String">
      <label>Legacy notification on server online</label>
      <default>{}</default>
    </entry>
    <entry name="notificationDown" type="String">
      <label>Legacy notification on server offline</label>
      <default>{}</default>
    </entry>
  </group>
</kcfg>
